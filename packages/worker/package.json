{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "db:init": "wrangler d1 execute sftp-status --local --file=schema.sql",
    "db:migrate": "wrangler d1 execute sftp-status --remote --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "@cloudflare/vitest-pool-workers": "^0.5.41",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.103.2"
  }
}
